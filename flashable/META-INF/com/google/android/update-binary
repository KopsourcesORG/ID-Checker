#!/sbin/sh

# ID Key Flasher Shell (flashable zip package)
# By KeJia

# env prepare
umask 022
TMPDIR=/tmp/idc
rm -rf "$TMPDIR" 2>/dev/null
mkdir -p "$TMPDIR" || exit 1
OUTFD=$2
ZIPFILE=$3
ui_print() {
  until [ ! "$1" ]; do
    echo "ui_print $1
      ui_print" >> /proc/self/fd/$OUTFD;
    shift;
  done;
}
abort() {
  ui_print "$1"
  rm -rf "$TMPDIR"
  exit 1
}

is_mounted() {
  while read -r device mount_path rest; do
    [ "$mount_path" = "$1" ] && return 0
  done < /proc/mounts
  return 1
}

# extract files
unzip "$ZIPFILE" -d "$TMPDIR" >&2 || abort "Could not extract installer files"

# run id-key-flasher
chmod 0755 "$TMPDIR/id-key-flasher" || abort "Could not prepare ID Key Flasher"

# Mount the persistent partition before installing the key.
if [ -d /persist ]; then
  PERSIST_PATH=/persist
elif [ -d /mnt/vendor/persist ]; then
  PERSIST_PATH=/mnt/vendor/persist
else
  abort "Persist mount point not found"
fi
if ! is_mounted "$PERSIST_PATH"; then
  mount "$PERSIST_PATH" || abort "Could not mount $PERSIST_PATH"
fi
is_mounted "$PERSIST_PATH" || abort "$PERSIST_PATH is not mounted"

"$TMPDIR/id-key-flasher" "$TMPDIR/id.ike2" || abort "Could not install ID key"

# clean up
cd /
rm -rf "$TMPDIR"
exit 0
